<view class="my-page"><view class="tops"><view class="bg-pattern"></view><view data-event-opts="{{[['tap',[['showLoginModal',['$event']]]]]}}" class="auth-section" bindtap="__e"><view class="avatar-container"><image class="auth-avatar" src="{{avatarUrl||'/static/default-avatar.png'}}" mode="aspectFill"></image><block wx:if="{{isLogged}}"><view class="avatar-status"></view></block></view><view class="user-info"><text class="auth-title">{{isLogged?nickName:'登录/注册'}}</text><block wx:if="{{isLogged}}"><text class="auth-subtitle">普通用户</text></block><block wx:else><text class="auth-subtitle">登录后体验更多功能</text></block></view><block wx:if="{{isLogged}}"><view class="auth-arrow"><uni-icons vue-id="bae1c640-1" type="right" size="16" color="#666" bind:__l="__l"></uni-icons></view></block></view></view><view class="dashboard"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="stat-item" hover-class="stat-item-hover"><view class="stat-icon"><uni-icons vue-id="{{'bae1c640-2-'+index}}" type="{{item.m0}}" size="22" color="#007AFF" bind:__l="__l"></uni-icons></view><text class="stat-value">{{item.$orig.value}}</text><text class="stat-label">{{item.$orig.label}}</text></view></block></view><view class="function-grid"><block wx:for="{{functionGroups}}" wx:for-item="group" wx:for-index="gIndex" wx:key="gIndex"><view class="grid-group"><block wx:for="{{group}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="grid-item" hover-class="grid-item-hover" data-event-opts="{{[['tap',[['handleFunction',['$0'],[[['functionGroups','',gIndex],['','',index]]]]]]]}}" bindtap="__e"><view class="item-icon-container"><uni-icons vue-id="{{'bae1c640-3-'+gIndex+'-'+index}}" type="{{item.icon}}" size="24" color="#007AFF" bind:__l="__l"></uni-icons></view><text class="item-label">{{item.label}}</text></view></block></view></block></view><view class="app-version"><text class="version-text">版本 1.0.0</text></view><block wx:if="{{showModal}}"><view data-event-opts="{{[['tap',[['closeLoginModal',['$event']]]]]}}" class="login-modal" catchtap="__e"><view class="modal-mask"></view><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="modal-content" catchtap="__e"><view class="modal-header"><text class="modal-title">微信登录</text><view data-event-opts="{{[['tap',[['closeLoginModal',['$event']]]]]}}" class="close-btn" bindtap="__e"><uni-icons vue-id="bae1c640-4" type="closeempty" size="20" color="#999" bind:__l="__l"></uni-icons></view></view><view class="modal-body"><image class="wechat-logo" src="/static/wechat-login.png" mode="aspectFit"></image><text class="modal-tips">授权后可同步您的微信昵称和头像</text><block wx:if="{{loginStep===1}}"><view><block wx:if="{{canIUseGetUserProfile}}"><button data-event-opts="{{[['tap',[['getUserProfile',['$event']]]]]}}" class="auth-button" bindtap="__e">微信一键登录</button></block><block wx:else><button class="auth-button" open-type="getUserInfo" data-event-opts="{{[['getuserinfo',[['getUserInfo',['$event']]]]]}}" bindgetuserinfo="__e">微信一键登录</button></block></view></block><block wx:else><block wx:if="{{loginStep===2}}"><view class="profile-form"><text class="form-title">完善头像和昵称</text><button class="avatar-wrapper" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar-preview" src="{{tempAvatarUrl||'/static/default-avatar.png'}}" mode="aspectFill"></image><text class="avatar-tip">点击选择头像</text></button><view class="nickname-wrapper"><text class="label">昵称</text><input class="nickname-input" type="nickname" placeholder="请输入昵称" data-event-opts="{{[['change',[['onInputNickname',['$event']]]],['input',[['__set_model',['','tempNickName','$event',[]]]]]]}}" value="{{tempNickName}}" bindchange="__e" bindinput="__e"/></view><button data-event-opts="{{[['tap',[['saveUserInfo',['$event']]]]]}}" class="save-button" bindtap="__e">保存</button></view></block></block></view></view></view></block></view>