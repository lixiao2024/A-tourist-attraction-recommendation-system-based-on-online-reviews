.content {
  background: #f8f9fa;
  min-height: 100vh;
}
.wallet-container {
  padding-bottom: 40rpx;
  position: relative;
}
.header-bg {
  background: linear-gradient(120deg, #3949AB, #1E88E5);
  height: 200rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  padding: 40rpx 30rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.wallet-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}
.balance-card {
  background: linear-gradient(135deg, #6200EA, #3949AB);
  margin: -80rpx 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}
.wallet-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.balance-amount {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin: 20rpx 0;
  display: block;
}
.card-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.action-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  border: none;
  gap: 8rpx;
  transition: all 0.3s ease;
}
.recharge-btn {
  background: rgba(255, 255, 255, 0.25);
}
.withdraw-btn {
  background: rgba(255, 255, 255, 0.15);
}
.btn-hover {
  -webkit-transform: scale(0.96);
          transform: scale(0.96);
  opacity: 0.9;
}
.card-pattern {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  -webkit-transform: translate(50%, 50%);
          transform: translate(50%, 50%);
  z-index: -1;
}
.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}
.quick-item-hover {
  -webkit-transform: translateY(-4rpx);
          transform: translateY(-4rpx);
}
.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.transfer-icon {
  background: linear-gradient(135deg, #FF9800, #FF5722);
}
.bill-icon {
  background: linear-gradient(135deg, #4CAF50, #009688);
}
.card-icon {
  background: linear-gradient(135deg, #9C27B0, #673AB7);
}
.settings-icon {
  background: linear-gradient(135deg, #607D8B, #455A64);
}
.quick-text {
  font-size: 24rpx;
  color: #666;
}
.transaction-section {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}
.view-all {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  gap: 4rpx;
}
.text-hover {
  color: #3949AB;
}
.transaction-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
.item-hover {
  background: rgba(0, 0, 0, 0.02);
}
.transaction-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.income-icon {
  background: linear-gradient(135deg, #4CAF50, #009688);
}
.expense-icon {
  background: linear-gradient(135deg, #F44336, #E91E63);
}
.transaction-info {
  flex: 1;
}
.transaction-title {
  font-size: 28rpx;
  color: #333;
  display: block;
}
.transaction-time {
  font-size: 22rpx;
  color: #999;
}
.transaction-amount {
  font-size: 32rpx;
  font-weight: 500;
}
.income {
  color: #4CAF50;
}
.expense {
  color: #F44336;
}
.no-more {
  text-align: center;
  padding: 30rpx 0 10rpx;
  font-size: 26rpx;
  color: #999;
}
.safety-tips {
  margin: 20rpx 30rpx;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.tip-icon {
  width: 40rpx;
  height: 40rpx;
  background: #607D8B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #666;
}
