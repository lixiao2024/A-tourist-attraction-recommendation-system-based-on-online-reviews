<view class="post-page"><view class="header-section"><text class="page-title">发布评论</text><text class="subtitle">分享你的旅行体验</text></view><view class="content-card"><input class="title-input" placeholder="请输入标题（可选）" maxlength="50" data-event-opts="{{[['input',[['__set_model',['','title','$event',[]]]]]]}}" value="{{title}}" bindinput="__e"/><view class="separator"></view><textarea class="content-input" placeholder="写下你的旅行体验，分享精彩瞬间..." maxlength="500" auto-height="{{true}}" data-event-opts="{{[['input',[['__set_model',['','content','$event',[]]]]]]}}" value="{{content}}" bindinput="__e"></textarea><block wx:if="{{$root.g0>0}}"><view class="image-upload-area"><scroll-view class="image-scroll" scroll-x="{{true}}"><view class="image-list"><block wx:for="{{images}}" wx:for-item="image" wx:for-index="index" wx:key="index"><view class="image-item"><image class="preview-image" src="{{image}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewImage',[index]]]]]}}" bindtap="__e"></image><view data-event-opts="{{[['tap',[['deleteImage',[index]]]]]}}" class="delete-image" catchtap="__e"><text class="delete-icon">×</text></view></view></block></view></scroll-view></view></block><view class="content-footer"><text class="word-count">{{$root.g1+"/500"}}</text></view></view><block wx:if="{{coverImage}}"><view class="cover-preview"><view class="preview-header"><text class="preview-title">封面图</text><view data-event-opts="{{[['tap',[['deleteCoverImage',['$event']]]]]}}" class="preview-action" bindtap="__e"><uni-icons vue-id="0d4588c0-1" type="trash" size="18" color="#718096" bind:__l="__l"></uni-icons><text class="action-text">删除</text></view></view><view class="cover-container"><image class="cover-image" src="{{coverImage}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewCoverImage',['$event']]]]]}}" bindtap="__e"></image></view></view></block><view class="tools-section"><text class="section-title">添加更多信息</text><view class="tools-bar"><view class="tool-item" hover-class="tool-item-hover" data-event-opts="{{[['tap',[['showTopicInput',['$event']]]]]}}" bindtap="__e"><view class="tool-icon"><uni-icons vue-id="0d4588c0-2" type="paperplane" size="20" color="#3182ce" bind:__l="__l"></uni-icons></view><text class="tool-text">{{"# "+($root.g2>0?'已添加'+$root.g3+'个话题':'添加话题')}}</text></view><view class="tool-item" hover-class="tool-item-hover" data-event-opts="{{[['tap',[['getLocation',['$event']]]]]}}" bindtap="__e"><view class="tool-icon"><uni-icons vue-id="0d4588c0-3" type="location" size="20" color="#3182ce" bind:__l="__l"></uni-icons></view><text class="tool-text">{{location||'添加位置'}}</text></view><view class="tool-item" hover-class="tool-item-hover" data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" bindtap="__e"><view class="tool-icon"><uni-icons vue-id="0d4588c0-4" type="image" size="20" color="#3182ce" bind:__l="__l"></uni-icons></view><text class="tool-text">{{$root.g4>0?'已上传'+$root.g5+'张图片':'上传图片'}}</text></view><view class="tool-item" hover-class="tool-item-hover" data-event-opts="{{[['tap',[['chooseCoverImage',['$event']]]]]}}" bindtap="__e"><view class="tool-icon"><uni-icons vue-id="0d4588c0-5" type="camera" size="20" color="#3182ce" bind:__l="__l"></uni-icons></view><text class="tool-text">{{coverImage?'更换封面':'选择封面'}}</text></view></view></view><block wx:if="{{$root.g6>0}}"><view class="topics-preview"><scroll-view class="topics-scroll" scroll-x="{{true}}"><view class="topics-list"><block wx:for="{{topics}}" wx:for-item="topic" wx:for-index="index" wx:key="index"><view class="topic-tag" hover-class="topic-tag-hover">{{'#'+topic+''}}<text data-event-opts="{{[['tap',[['removeTopic',[index]]]]]}}" class="delete-topic" catchtap="__e">×</text></view></block></view></scroll-view></view></block><uni-popup class="vue-ref" vue-id="0d4588c0-6" type="bottom" data-ref="topicPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="topic-popup"><view class="popup-header"><text class="popup-title">添加话题</text><view class="close-btn" hover-class="close-btn-hover" data-event-opts="{{[['tap',[['closeTopicPopup',['$event']]]]]}}" bindtap="__e">关闭</view></view><view class="search-box"><uni-icons vue-id="{{('0d4588c0-7')+','+('0d4588c0-6')}}" type="search" size="20" color="#a0aec0" bind:__l="__l"></uni-icons><input class="topic-input" placeholder="搜索或创建新话题" confirm-type="done" data-event-opts="{{[['confirm',[['addTopic',['$event']]]],['input',[['__set_model',['','topicInput','$event',[]]]]]]}}" value="{{topicInput}}" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{!topicInput}}"><view class="trending-topics"><text class="trending-title">热门话题</text><view class="trending-list"><block wx:for="{{['旅行','美食','风景','城市','历史','文化']}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="trending-tag" hover-class="trending-tag-hover" data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" bindtap="__e">{{'#'+item+''}}</view></block></view></view></block><block wx:if="{{$root.g7>0}}"><view class="added-topics"><text class="added-title">已添加话题</text><view class="topics-list popup-topics"><block wx:for="{{topics}}" wx:for-item="topic" wx:for-index="index" wx:key="index"><view class="topic-tag popup-tag" hover-class="topic-tag-hover">{{'#'+topic+''}}<text data-event-opts="{{[['tap',[['removeTopic',[index]]]]]}}" class="delete-topic" catchtap="__e">×</text></view></block></view></view></block></view></uni-popup><view class="submit-wrapper"><button class="submit-btn" hover-class="submit-btn-hover" data-event-opts="{{[['tap',[['submitComment',['$event']]]]]}}" bindtap="__e"><text class="btn-text">发布评论</text><uni-icons vue-id="0d4588c0-8" type="arrowright" size="18" color="#fff" bind:__l="__l"></uni-icons></button></view></view>