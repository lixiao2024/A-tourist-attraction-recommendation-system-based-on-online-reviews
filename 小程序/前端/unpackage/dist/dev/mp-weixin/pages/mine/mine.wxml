<view class="my-page"><view class="tops"><view class="bg-pattern"></view><view data-event-opts="{{[['tap',[['handleAuth',['$event']]]]]}}" class="auth-section" bindtap="__e"><view class="avatar-container"><image class="auth-avatar" src="{{avatarUrl||'/static/default-avatar.png'}}" mode="aspectFill"></image><block wx:if="{{isLogged}}"><view class="avatar-status"></view></block></view><view class="user-info"><text class="auth-title">{{isLogged?nickName:'登录/注册'}}</text><block wx:if="{{isLogged}}"><text class="auth-subtitle">普通用户</text></block><block wx:else><text class="auth-subtitle">登录后体验更多功能</text></block></view><block wx:if="{{isLogged}}"><view class="auth-arrow"><uni-icons vue-id="bae1c640-1" type="right" size="16" color="#666" bind:__l="__l"></uni-icons></view></block></view></view><view class="dashboard"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="stat-item" hover-class="stat-item-hover"><view class="stat-icon"><uni-icons vue-id="{{'bae1c640-2-'+index}}" type="{{item.m0}}" size="22" color="#007AFF" bind:__l="__l"></uni-icons></view><text class="stat-value">{{item.$orig.value}}</text><text class="stat-label">{{item.$orig.label}}</text></view></block></view><view class="function-grid"><block wx:for="{{functionGroups}}" wx:for-item="group" wx:for-index="gIndex" wx:key="gIndex"><view class="grid-group"><block wx:for="{{group}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="grid-item" hover-class="grid-item-hover" data-event-opts="{{[['tap',[['handleFunction',['$0'],[[['functionGroups','',gIndex],['','',index]]]]]]]}}" bindtap="__e"><view class="item-icon-container"><uni-icons vue-id="{{'bae1c640-3-'+gIndex+'-'+index}}" type="{{item.icon}}" size="24" color="#007AFF" bind:__l="__l"></uni-icons></view><text class="item-label">{{item.label}}</text></view></block></view></block></view><view class="app-version"><text class="version-text">版本 1.0.0</text></view></view>