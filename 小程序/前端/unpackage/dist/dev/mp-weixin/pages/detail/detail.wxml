<view class="container"><view class="comment-section"><block wx:if="{{isDataLoaded}}"><view class="comment-card"><view class="user-info"><image class="avatar" src="{{detail.avatar}}" mode="aspectFill"></image><view class="user-meta"><text class="nickname">{{detail.nickname}}</text><text class="publish-time">{{detail.publishTime}}</text></view></view><view class="content-wrapper"><text class="content-text">{{detail.content}}</text><block wx:if="{{$root.g0}}"><view class="images-container"><block wx:for="{{detail.images}}" wx:for-item="image" wx:for-index="index" wx:key="index"><image class="content-image" src="{{image}}" mode="widthFix" data-event-opts="{{[['tap',[['previewImage',['$0','$1'],[[['detail.images','',index]],'detail.images']]]],['error',[['handleImageError',[index]]]]]}}" bindtap="__e" binderror="__e"></image></block></view></block></view><view class="interaction-bar"><view data-event-opts="{{[['tap',[['toggleLike',['$event']]]]]}}" class="{{['interaction-button',(detail.isLiked)?'active':'']}}" bindtap="__e"><uni-icons vue-id="3db16520-1" type="{{detail.isLiked?'heart-filled':'heart'}}" size="24" color="{{detail.isLiked?'#ff5656':'#666'}}" bind:__l="__l"></uni-icons><text class="{{['button-text',(detail.isLiked)?'active':'']}}">{{detail.likeCount>0?detail.likeCount:'点赞'}}</text></view><view data-event-opts="{{[['tap',[['showCommentInput',['$event']]]]]}}" class="interaction-button" bindtap="__e"><uni-icons vue-id="3db16520-2" type="chatbubble" size="24" color="#666" bind:__l="__l"></uni-icons><text class="button-text">{{detail.commentCount>0?detail.commentCount:'评论'}}</text></view><view data-event-opts="{{[['tap',[['toggleCollect',['$event']]]]]}}" class="{{['interaction-button',(detail.isCollected)?'active':'']}}" bindtap="__e"><uni-icons vue-id="3db16520-3" type="{{detail.isCollected?'star-filled':'star'}}" size="24" color="{{detail.isCollected?'#ffc107':'#666'}}" bind:__l="__l"></uni-icons><text class="{{['button-text',(detail.isCollected)?'active':'']}}">{{detail.isCollected?'已收藏':'收藏'}}</text></view><view data-event-opts="{{[['tap',[['toggleFollow',['$event']]]]]}}" class="{{['interaction-button',(detail.isFollowed)?'active':'']}}" bindtap="__e"><uni-icons vue-id="3db16520-4" type="{{detail.isFollowed?'plusempty':'plus'}}" size="24" color="{{detail.isFollowed?'#3182ce':'#666'}}" bind:__l="__l"></uni-icons><text class="{{['button-text',(detail.isFollowed)?'active':'']}}">{{detail.isFollowed?'已关注':'关注'}}</text></view></view></view></block><block wx:if="{{!isDataLoaded}}"><view class="loading-indicator"><uni-icons vue-id="3db16520-5" type="spinner-cycle" size="30" color="#3182ce" bind:__l="__l"></uni-icons><text class="loading-text">加载中...</text></view></block></view><view class="replies-header"><text class="replies-title">{{"全部评论 ("+(detail.commentCount||0)+")"}}</text><text class="sort-button">最新</text></view><scroll-view class="reply-list" scroll-y="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{isRefreshing}}" data-event-opts="{{[['scrolltolower',[['onScrollToLower',['$event']]]],['refresherrefresh',[['refreshComments',['$event']]]]]}}" bindscrolltolower="__e" bindrefresherrefresh="__e"><block wx:if="{{$root.g1>0}}"><view class="reply-container"><block wx:for="{{replies}}" wx:for-item="reply" wx:for-index="index" wx:key="id"><view class="{{['reply-item',(replyHoverId===reply.id)?'reply-item-hover':'']}}" hover-class="reply-item-hover" data-event-opts="{{[['touchstart',[['e0',['$event']]]],['touchend',[['e1',['$event']]]]]}}" data-event-params="{{({reply})}}" bindtouchstart="__e" bindtouchend="__e"><image class="reply-avatar" src="{{reply.avatar}}" mode="aspectFill"></image><view class="reply-content"><view class="reply-header"><text class="reply-nickname">{{reply.nickname}}</text><text class="reply-time">{{reply.publishTime}}</text></view><text class="reply-text">{{reply.content}}</text><view class="reply-actions"><view data-event-opts="{{[['tap',[['toggleReplyLike',[index]]]]]}}" class="reply-like" catchtap="__e"><uni-icons vue-id="{{'3db16520-6-'+index}}" type="{{reply.isLiked?'heart-filled':'heart'}}" size="16" color="{{reply.isLiked?'#ff5656':'#999'}}" bind:__l="__l"></uni-icons><text class="{{[(reply.isLiked)?'liked-text':'']}}">{{reply.likeCount||'点赞'}}</text></view><view data-event-opts="{{[['tap',[['replyToComment',['$0'],[[['replies','id',reply.id]]]]]]]}}" class="reply-comment" catchtap="__e"><uni-icons vue-id="{{'3db16520-7-'+index}}" type="chatbubble" size="16" color="#999" bind:__l="__l"></uni-icons><text>回复</text></view></view></view></view></block></view></block><block wx:else><block wx:if="{{!loading}}"><view class="empty-replies"><uni-icons vue-id="3db16520-8" type="info" size="60" color="#cccccc" bind:__l="__l"></uni-icons><text class="empty-text">暂无评论，快来发表第一条评论吧</text></view></block></block><block wx:if="{{loading}}"><view class="loading-more"><uni-icons vue-id="3db16520-9" type="spinner-cycle" size="20" color="#999" bind:__l="__l"></uni-icons><text>加载中...</text></view></block><block wx:if="{{$root.g2}}"><view class="no-more"><text>没有更多评论了</text></view></block></scroll-view><block wx:if="{{showCommentBox}}"><view class="comment-input-area"><view class="input-wrapper"><input class="comment-input" placeholder="{{replyPlaceholder}}" focus="{{true}}" cursor-spacing="20" confirm-type="send" maxlength="200" data-event-opts="{{[['confirm',[['submitComment',['$event']]]],['input',[['__set_model',['','replyContent','$event',[]]]]]]}}" value="{{replyContent}}" bindconfirm="__e" bindinput="__e"/><text class="word-count">{{$root.g3+"/200"}}</text></view><button class="{{['send-btn',($root.g4>0)?'send-btn-active':'']}}" disabled="{{$root.g5===0}}" data-event-opts="{{[['tap',[['submitComment',['$event']]]]]}}" bindtap="__e">发送</button></view></block><block wx:if="{{!showCommentBox}}"><view data-event-opts="{{[['tap',[['showCommentInput',['$event']]]]]}}" class="bottom-comment-btn" bindtap="__e"><uni-icons vue-id="3db16520-10" type="chatboxes" size="20" color="#FFFFFF" bind:__l="__l"></uni-icons><text>写评论...</text></view></block><block wx:if="{{showLoginPopup}}"><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="login-popup" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="{{['login-container',(showLoginPopup)?'show':'']}}" catchtap="__e"><view class="login-header"><text class="login-title">登录</text><view data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="close-btn" bindtap="__e"><uni-icons vue-id="3db16520-11" type="closeempty" size="24" color="#666" bind:__l="__l"></uni-icons></view></view><view class="login-content"><image class="login-avatar" src="/static/default-avatar.png" mode="aspectFill"></image><text class="login-desc">登录后才能点赞、评论和收藏哦</text><button data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="login-btn" bindtap="__e">微信登录</button></view></view></view></block></view>